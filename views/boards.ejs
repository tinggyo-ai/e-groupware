<%- include('partials/head') %>
<main class="container">
  <div class="page-title"><h1><%= selectedBoard ? selectedBoard.name : '게시판' %></h1></div>
  <div class="board-layout">
    <aside class="panel board-menu">
      <% boards.forEach(function(board) { %><a href="/boards/<%= board.id %>"><%= board.name %></a><% }) %>
    </aside>
    <section class="panel">
      <% if (selectedBoard) { %>
        <form class="filter-bar" method="get">
          <input name="q" placeholder="제목 또는 내용 검색" value="<%= q %>">
          <button class="button" type="submit">검색</button>
        </form>
        <form action="/boards/<%= selectedBoard.id %>/posts" method="post" class="form-stack compact">
          <input name="title" placeholder="제목" required>
          <textarea name="content" rows="4" placeholder="내용" required></textarea>
          <button class="button primary" type="submit">게시글 작성</button>
        </form>
      <% } %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>게시판</th><th>제목</th><th>작성자</th><th>작성일</th></tr></thead>
          <tbody>
            <% posts.forEach(function(post) { %>
              <tr>
                <td><%= post.board_name %></td>
                <td><% if (post.is_pinned) { %><span class="badge">고정</span><% } %> <%= post.title %><p class="muted"><%= post.content %></p></td>
                <td><%= post.author %></td><td><%= post.created_at.slice(0,10) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
