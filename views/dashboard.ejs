<%- include('partials/head') %>
<%
  const attendance = data.attendance || {};
  const checkInTime = attendance.check_in_time ? attendance.check_in_time.slice(11, 16) : '-';
  const checkOutTime = attendance.check_out_time ? attendance.check_out_time.slice(11, 16) : '-';
  const workStatus = attendance.status || '출근 전';
  const approvalStates = [
    { key: '임시저장', icon: 'fa-regular fa-pen-to-square' },
    { key: '진행중', icon: 'fa-solid fa-stopwatch' },
    { key: '승인', icon: 'fa-solid fa-check-circle' },
    { key: '반려', icon: 'fa-regular fa-rectangle-xmark' }
  ];
  function approvalCount(status) {
    const item = data.myApprovals.find(x => x.status === status);
    return item ? item.count : 0;
  }
  function shortDate(value) {
    return value ? value.slice(0, 10).replaceAll('-', '.') : '';
  }
%>

<main class="container dashboard-page">
  <section class="dashboard-hero">
    <div class="dashboard-hero-copy">
      <span class="eyebrow">오늘의 업무 현황</span>
      <h1><%= currentUser.name %>님, 안녕하세요</h1>
      <p><%= currentUser.departmentName || '부서 미지정' %> · <%= currentUser.position || '-' %> · <%= currentUser.email %></p>
    </div>
    <a class="dashboard-it-card" href="<%= itReportUrl %>" target="_blank" rel="noopener">
      <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
      <span>
        <strong>Help Desk</strong>
        <small>지원 요청 바로가기</small>
      </span>
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    </a>
  </section>

  <div class="dashboard-main-row">
    <div class="dashboard-left-col">
      <section class="quick-actions" aria-label="출퇴근 기록">
        <form action="/attendance/check-in" method="post">
          <button class="big-action in" type="submit">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <span>
              <strong>출근하기</strong>
              <small>오늘 업무 시작 기록</small>
            </span>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </form>
        <form action="/attendance/check-out" method="post">
          <button class="big-action out" type="submit">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <span>
              <strong>퇴근하기</strong>
              <small>오늘 업무 종료 기록</small>
            </span>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </form>
      </section>

      <section class="card-grid dashboard-metrics" aria-label="근무 요약">
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>오늘 출근 시간</span>
            <i class="fa-regular fa-clock kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= checkInTime %></strong>
        </article>
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>오늘 퇴근 시간</span>
            <i class="fa-regular fa-moon kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= checkOutTime %></strong>
        </article>
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>현재 근무 상태</span>
            <i class="fa-regular fa-circle-user kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= workStatus %></strong>
        </article>
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>이번 달 근무일수</span>
            <i class="fa-regular fa-calendar kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= data.monthStats.work_days || 0 %>일</strong>
        </article>
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>이번 달 지각 횟수</span>
            <i class="fa-regular fa-bell kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= data.monthStats.late_count || 0 %>회</strong>
        </article>
        <article class="card kpi-card">
          <div class="kpi-row">
            <span>결재 대기 건수</span>
            <i class="fa-regular fa-file-lines kpi-icon" aria-hidden="true"></i>
          </div>
          <strong><%= data.pendingApprovals.count || 0 %>건</strong>
        </article>
      </section>
    </div>

    <section class="connected-services-panel" aria-label="연동 서비스 바로가기">
      <div class="cs-panel-header">
        <span class="cs-panel-tag">// AI WORKSPACE HUB</span>
        <h2 class="cs-panel-title">AI 연동 서비스 허브 <span class="cs-live-dot"></span></h2>
      </div>
      <div class="cs-grid">

        <a class="cs-card" href="<%= messengerUrl %>" target="_blank" rel="noopener">
          <div class="cs-icon cs-icon--messenger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <div class="cs-info">
            <em class="cs-cat">MESSENGER</em>
            <strong>E-Messenger</strong>
            <small>실시간 메신저</small>
          </div>
          <span class="cs-badge cs-badge--online">ONLINE</span>
        </a>

        <button class="cs-card cs-card--desktop" type="button"
                data-app-name="Essence (AI 챗봇 - Groq)"
                onclick="showDesktopAppModal(this)">
          <div class="cs-icon cs-icon--essence">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 8v4l3 3"/>
            </svg>
          </div>
          <div class="cs-info">
            <em class="cs-cat">AI CHATBOT</em>
            <strong>Essence</strong>
            <small>AI 챗봇 · Groq</small>
          </div>
          <span class="cs-badge cs-badge--desktop">DESKTOP</span>
        </button>

        <button class="cs-card cs-card--desktop" type="button"
                data-app-name="Essence On (오프라인 AI 챗봇)"
                onclick="showDesktopAppModal(this)">
          <div class="cs-icon cs-icon--essence-on">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="cs-info">
            <em class="cs-cat">AI CHATBOT · ON-PREM</em>
            <strong>Essence On</strong>
            <small>오프라인 AI 챗봇</small>
          </div>
          <span class="cs-badge cs-badge--desktop">DESKTOP</span>
        </button>

        <a class="cs-card" href="<%= assetMgmtUrl %>" target="_blank" rel="noopener">
          <div class="cs-icon cs-icon--asset">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
          <div class="cs-info">
            <em class="cs-cat">ASSET · IT MANAGEMENT</em>
            <strong>E-자산통합관리</strong>
            <small>자산 · IT 서비스데스크</small>
          </div>
          <span class="cs-badge cs-badge--online">ONLINE</span>
        </a>

        <div class="cs-card cs-card--disabled" aria-disabled="true">
          <div class="cs-icon cs-icon--security">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M12 8v4M12 16h.01"/>
            </svg>
          </div>
          <div class="cs-info">
            <em class="cs-cat">SECURITY</em>
            <strong>E-Security</strong>
            <small>보안 관리</small>
          </div>
          <span class="cs-badge cs-badge--soon">SOON</span>
        </div>

      </div>
    </section>
  </div>

  <div class="cs-modal-backdrop" id="csModalBackdrop" hidden>
    <div class="cs-modal" role="dialog" aria-modal="true" aria-labelledby="csModalTitle">
      <div class="cs-modal-icon">
        <i class="fa-solid fa-desktop" aria-hidden="true"></i>
      </div>
      <h3 id="csModalTitle">데스크톱 앱 실행</h3>
      <p id="csModalBody">이 서비스는 데스크톱 앱으로 제공됩니다.<br>바탕화면 또는 시작 메뉴에서 직접 실행해 주세요.</p>
      <button class="button primary cs-modal-close" onclick="closeDesktopAppModal()">확인</button>
    </div>
  </div>

  <section class="dashboard-panels">
    <article class="panel dashboard-panel approvals-panel">
      <div class="section-head">
        <h2>내 결재 진행 상태</h2>
        <a class="text-link" href="/approvals/new">새 문서</a>
      </div>
      <div class="status-row">
        <% approvalStates.forEach(function(status) { %>
          <span>
            <i class="<%= status.icon %>" aria-hidden="true"></i>
            <b><%= status.key %></b>
            <strong><%= approvalCount(status.key) %></strong>
          </span>
        <% }) %>
      </div>
    </article>

    <article class="panel dashboard-panel">
      <div class="section-head">
        <h2>최신 공지사항</h2>
        <a class="text-link" href="/boards">전체 보기</a>
      </div>
      <ul class="clean-list dashboard-list">
        <% if (data.latestNotices.length) { %>
          <% data.latestNotices.slice(0, 3).forEach(function(post) { %>
            <li>
              <a href="/boards/<%= post.board_id %>"><%= post.title %></a>
              <small><%= post.author %></small>
              <time><%= shortDate(post.created_at) %></time>
            </li>
          <% }) %>
        <% } else { %>
          <li class="empty-cell">등록된 공지사항이 없습니다.</li>
        <% } %>
      </ul>
    </article>

    <article class="panel dashboard-panel">
      <div class="section-head">
        <h2>최신 게시글</h2>
        <a class="text-link" href="/boards">게시판 이동</a>
      </div>
      <ul class="clean-list dashboard-list">
        <% if (data.latestPosts.length) { %>
          <% data.latestPosts.slice(0, 3).forEach(function(post) { %>
            <li>
              <a href="/boards/<%= post.board_id %>"><%= post.title %></a>
              <small><%= post.board_name %></small>
              <time><%= shortDate(post.created_at) %></time>
            </li>
          <% }) %>
        <% } else { %>
          <li class="empty-cell">등록된 게시글이 없습니다.</li>
        <% } %>
      </ul>
    </article>
  </section>
</main>
<script>
(function () {
  var backdrop = document.getElementById('csModalBackdrop');
  var body = document.getElementById('csModalBody');
  window.showDesktopAppModal = function (btn) {
    var name = btn.dataset.appName || '앱';
    body.innerHTML = '<b>' + name + '</b> 은(는) 데스크톱 앱으로 제공됩니다.<br>바탕화면 또는 시작 메뉴에서 직접 실행해 주세요.';
    backdrop.hidden = false;
  };
  window.closeDesktopAppModal = function () {
    backdrop.hidden = true;
  };
  backdrop.addEventListener('click', function (e) {
    if (e.target === backdrop) backdrop.hidden = true;
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !backdrop.hidden) backdrop.hidden = true;
  });
}());
</script>
<%- include('partials/footer') %>
