<%- include('../partials/head') %>
<main class="admin-shell">
  <%- include('../partials/admin-nav') %>
  <section class="admin-content admin-dashboard-page">
    <section class="admin-hero">
      <div>
        <span class="eyebrow">관리자 콘솔</span>
        <h1>시스템 운영 현황</h1>
        <p>직원, 근태, 결재, 게시판 설정을 한 곳에서 관리합니다.</p>
      </div>
      <a class="admin-hero-action" href="/dashboard">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>
          <strong>업무 화면</strong>
          <small>대시보드로 이동</small>
        </span>
      </a>
    </section>

    <section class="card-grid admin-metrics">
      <article class="card">
        <div class="kpi-row">
          <span>전체 직원 수</span>
          <i class="fa-solid fa-users kpi-icon" aria-hidden="true"></i>
        </div>
        <strong><%= stats.totalUsers %>명</strong>
      </article>
      <article class="card">
        <div class="kpi-row">
          <span>오늘 출근 인원</span>
          <i class="fa-regular fa-clock kpi-icon" aria-hidden="true"></i>
        </div>
        <strong><%= stats.checkedIn %>명</strong>
      </article>
      <article class="card">
        <div class="kpi-row">
          <span>오늘 미출근 인원</span>
          <i class="fa-regular fa-user kpi-icon" aria-hidden="true"></i>
        </div>
        <strong><%= stats.absent %>명</strong>
      </article>
      <article class="card">
        <div class="kpi-row">
          <span>결재 대기 건수</span>
          <i class="fa-regular fa-file-lines kpi-icon" aria-hidden="true"></i>
        </div>
        <strong><%= stats.pendingApprovals %>건</strong>
      </article>
    </section>

    <section class="two-col admin-panels">
      <article class="panel admin-panel">
        <div class="section-head">
          <h2>최근 공지사항</h2>
          <a class="text-link" href="/admin/boards">게시판 관리</a>
        </div>
        <ul class="clean-list admin-list">
          <% if (notices.length) { %>
            <% notices.forEach(n => { %>
              <li><span><%= n.title %></span><small><%= n.created_at.slice(0,10).replaceAll('-', '.') %></small></li>
            <% }) %>
          <% } else { %>
            <li class="empty-cell">등록된 공지사항이 없습니다.</li>
          <% } %>
        </ul>
      </article>

      <article class="panel admin-panel">
        <div class="section-head">
          <h2>최근 관리자 작업 로그</h2>
          <a class="text-link" href="/admin/logs">전체 보기</a>
        </div>
        <ul class="clean-list admin-list">
          <% if (logs.length) { %>
            <% logs.forEach(l => { %>
              <li><span><%= l.action %></span><small><%= l.admin_name %> · <%= l.created_at.slice(0,16).replace('T',' ') %></small></li>
            <% }) %>
          <% } else { %>
            <li class="empty-cell">관리자 작업 로그가 없습니다.</li>
          <% } %>
        </ul>
      </article>
    </section>
  </section>
</main>
<%- include('../partials/footer') %>
