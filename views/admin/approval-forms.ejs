<%- include('../partials/head') %>
<main class="admin-shell"><%- include('../partials/admin-nav') %><section class="admin-content">
  <div class="page-title"><h1>결재 양식 관리</h1></div>
  <form class="panel form-grid" action="/admin/approval-forms" method="post"><label>양식명 <input name="form_name" required></label><label>유형 <input name="form_type"></label><label>스키마 <input name="form_schema" value='{"fields":["title","content","amount"]}'></label><label><input type="checkbox" name="is_active" checked> 사용</label><button class="button primary">등록</button></form>
  <div class="panel table-wrap"><table><thead><tr><th>양식명</th><th>유형</th><th>스키마</th><th>사용</th><th>저장</th></tr></thead><tbody>
    <% forms.forEach(f => { %><tr><form action="/admin/approval-forms/<%= f.id %>/update" method="post"><td><input name="form_name" value="<%= f.form_name %>"></td><td><input name="form_type" value="<%= f.form_type || '' %>"></td><td><input name="form_schema" value='<%= f.form_schema || "{}" %>'></td><td><input type="checkbox" name="is_active" <%= f.is_active ? 'checked' : '' %>></td><td><button>저장</button></td></form></tr><% }) %>
  </tbody></table></div>
</section></main>
<%- include('../partials/footer') %>
