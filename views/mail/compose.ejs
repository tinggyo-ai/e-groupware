<%- include('../partials/head', { title: title }) %>
<main class="main-content">
  <div class="page-header">
    <h1 class="page-title"><i class="fa-solid fa-pen-to-square"></i> 메일 쓰기</h1>
    <a class="btn btn-outline" href="/mail"><i class="fa-solid fa-arrow-left"></i> 목록</a>
  </div>

  <% if (typeof error !== 'undefined') { %>
    <div class="flash danger"><%= error %></div>
  <% } %>

  <div class="card">
    <form method="post" action="/mail/compose" style="padding:20px;display:flex;flex-direction:column;gap:16px">
      <div class="form-group">
        <label class="form-label">보내는 사람</label>
        <input type="text" class="form-control" value="<%= settings.mail_address %>" disabled style="color:var(--text-muted)">
      </div>
      <div class="form-group">
        <label class="form-label">받는 사람 <span style="color:var(--danger)">*</span></label>
        <input type="email" class="form-control" name="to" value="<%= to %>" required
               placeholder="example@cgessence.co.kr">
      </div>
      <div class="form-group">
        <label class="form-label">제목 <span style="color:var(--danger)">*</span></label>
        <input type="text" class="form-control" name="subject" value="<%= subject %>" required
               placeholder="메일 제목을 입력하세요">
      </div>
      <div class="form-group">
        <label class="form-label">내용 <span style="color:var(--danger)">*</span></label>
        <textarea class="form-control" name="body" rows="14" required
                  placeholder="내용을 입력하세요" style="resize:vertical"><%= body %></textarea>
      </div>
      <div style="display:flex;gap:8px">
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-paper-plane"></i> 발송
        </button>
        <a href="/mail" class="btn btn-outline">취소</a>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
