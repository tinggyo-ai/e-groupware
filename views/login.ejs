<%- include('partials/head') %>

<div class="login-page-bg">
  <main class="login-wrap" aria-label="E-Groupware 로그인">
    <section class="lp-left" aria-label="E-Groupware 소개">
      <div class="lp-network" aria-hidden="true">
        <span class="lp-line lp-line-1"></span>
        <span class="lp-line lp-line-2"></span>
        <span class="lp-line lp-line-3"></span>
        <span class="lp-glow lp-glow-1"></span>
        <span class="lp-glow lp-glow-2"></span>
        <span class="lp-glow lp-glow-3"></span>
        <span class="lp-glow lp-glow-4"></span>
      </div>

      <header class="lp-header">
        <div class="lp-header-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </div>
        <div>
          <div class="lp-header-name">E-Groupware</div>
          <div class="lp-header-sub">AI Groupware Portal</div>
        </div>
      </header>

      <div class="lp-hero">
        <div class="lp-copy-block">
          <p class="lp-badge">AI가 함께하는 스마트한 업무 환경</p>
          <h1 class="lp-title">E-Groupware</h1>
          <p class="lp-accentline">AI Groupware Portal</p>
          <p class="lp-desc">
            AI가 도와주는 중소기업 업무 운영 플랫폼<br>
            전자결재, 공지사항, 근태관리, 사내 메일과 메신저,<br>
            자산관리와 조직관리까지 하나의 플랫폼에서 관리하세요.
          </p>

          <div class="lp-tiles" aria-label="주요 기능">
            <div class="lp-tile">
              <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
              <span>전자결재</span>
            </div>
            <div class="lp-tile">
              <i class="fa-regular fa-calendar-check" aria-hidden="true"></i>
              <span>근태관리</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
              <span>사내 메신저</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i>
              <span>사내 메일</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
              <span>자산관리</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-sitemap" aria-hidden="true"></i>
              <span>조직관리</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-headphones-simple" aria-hidden="true"></i>
              <span>Help Desk</span>
            </div>
            <div class="lp-tile">
              <i class="fa-solid fa-robot" aria-hidden="true"></i>
              <span>AI 업무지원</span>
            </div>
          </div>
        </div>

        <figure class="lp-illustration" aria-hidden="true">
          <img src="/images/login-hero-illustration.png" alt="">
        </figure>
      </div>

      <div class="lp-copy">© 2026 CGEssence. All rights reserved.</div>
    </section>

    <section class="lp-right" aria-label="로그인 양식">
      <div class="lp-form-box">
        <div class="lp-form-heading">
          <div class="lp-form-icon" aria-hidden="true">
            <i class="fa-solid fa-lock"></i>
          </div>
          <div>
            <h2 class="lp-form-title">로그인</h2>
            <p class="lp-form-sub">개인 정보를 입력한 뒤 로그인 해주세요</p>
          </div>
        </div>

        <% if (locals.flash) { %>
          <div class="login-flash login-flash-<%= flash.type %>">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span><%= flash.message %></span>
          </div>
        <% } %>

        <form action="/login" method="post" class="lp-login-form">
          <div class="lp-field">
            <label for="loginUsername">아이디</label>
            <div class="lp-input-wrap">
              <i class="fa-regular fa-user lp-input-icon" aria-hidden="true"></i>
              <input id="loginUsername" name="username" autocomplete="username" required placeholder="아이디 입력">
            </div>
          </div>

          <div class="lp-field">
            <label for="lpPwInput">비밀번호</label>
            <div class="lp-input-wrap">
              <i class="fa-solid fa-lock lp-input-icon" aria-hidden="true"></i>
              <input id="lpPwInput" name="password" type="password" autocomplete="current-password" required placeholder="비밀번호 입력">
              <button type="button" class="lp-pw-toggle" onclick="togglePw()" aria-label="비밀번호 보기 전환">
                <i id="lpPwEye" class="fa-regular fa-eye-slash" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <button class="btn-login" type="submit">
            <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>
            <span>로그인</span>
          </button>
        </form>

        <div class="lp-links">
          <a href="#">비밀번호 찾기</a>
          <span class="lp-links-div" aria-hidden="true"></span>
          <a href="mailto:<%= locals.adminEmail || '' %>">관리자 문의</a>
        </div>
      </div>

      <div class="lp-security-badge">
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        <span>보안 인증으로 안전하게 보호됩니다.</span>
      </div>
    </section>
  </main>
</div>

<script>
function togglePw() {
  var inp = document.getElementById('lpPwInput');
  var eye = document.getElementById('lpPwEye');
  if (inp.type === 'password') {
    inp.type = 'text';
    eye.className = 'fa-regular fa-eye';
  } else {
    inp.type = 'password';
    eye.className = 'fa-regular fa-eye-slash';
  }
}

(function () {
  var inputSelector = '.lp-input-wrap input';
  var fontLarge = '800 20px/1.2 "Segoe UI", Arial, "Noto Sans KR", sans-serif';
  var fontCompact = '800 17px/1.2 "Segoe UI", Arial, "Noto Sans KR", sans-serif';
  var bullet = '\u2022';
  var editingInputs = new WeakSet();

  function isCompactLogin() {
    return window.matchMedia('(min-width: 1041px) and (max-width: 1440px) and (max-height: 860px)').matches;
  }

  function mirrorText(input) {
    if (!input.value) return '';
    if (input.type === 'password') return bullet.repeat(input.value.length);
    return input.value;
  }

  function ensureMirror(input) {
    var wrap = input.closest('.lp-input-wrap');
    if (!wrap) return null;

    var mirror = wrap.querySelector('.lp-value-mirror');
    if (!mirror) {
      mirror = document.createElement('span');
      mirror.className = 'lp-value-mirror';
      mirror.setAttribute('aria-hidden', 'true');
      input.insertAdjacentElement('afterend', mirror);
    }
    return mirror;
  }

  function syncMirror(input) {
    var wrap = input.closest('.lp-input-wrap');
    var mirror = ensureMirror(input);
    if (!wrap || !mirror) return;

    var text = mirrorText(input);
    var isEditing = editingInputs.has(input);
    wrap.classList.toggle('is-editing', isEditing);
    if (text) {
      mirror.textContent = text;
      wrap.classList.add('has-value-mirror');
    } else if (isEditing || !mirror.textContent) {
      mirror.textContent = '';
      wrap.classList.remove('has-value-mirror');
    }
    // input.value 접근 불가(autofill 보안)이나 prefill이 있으면 그대로 유지
  }

  function fixLoginInputFont(input) {
    if (!input) return;
    var sz = isCompactLogin() ? '17px' : '20px';
    input.classList.add('lp-autofill-fixed');
    input.style.setProperty('font-size', sz, 'important');
    input.style.setProperty('font-weight', '800', 'important');
    input.style.setProperty('font-family', '"Segoe UI", Arial, "Noto Sans KR", sans-serif', 'important');
    input.style.setProperty('line-height', '1.2', 'important');
    input.style.setProperty('letter-spacing', '0', 'important');
    syncMirror(input);
  }

  function fixAllLoginInputFonts() {
    document.querySelectorAll(inputSelector).forEach(fixLoginInputFont);
  }

  document.addEventListener('DOMContentLoaded', function () {
    fixAllLoginInputFonts();
    [80, 240, 600, 1200, 2500, 5000].forEach(function (delay) {
      window.setTimeout(fixAllLoginInputFonts, delay);
    });
  });

  window.addEventListener('pageshow', fixAllLoginInputFonts);
  window.addEventListener('resize', fixAllLoginInputFonts);
  window.addEventListener('focus', function () {
    setTimeout(fixAllLoginInputFonts, 100);
    setTimeout(fixAllLoginInputFonts, 400);
  });

  document.addEventListener('click', function () {
    fixAllLoginInputFonts();
  });

  document.addEventListener('DOMContentLoaded', function () {
    [100, 300, 700].forEach(function (d) {
      setTimeout(function () {
        document.body.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
      }, d);
    });
  });

  document.addEventListener('input', function (event) {
    if (event.target && event.target.matches(inputSelector)) {
      editingInputs.add(event.target);
      fixLoginInputFont(event.target);
    }
  });
  document.addEventListener('change', function (event) {
    if (event.target && event.target.matches(inputSelector)) fixLoginInputFont(event.target);
  });
  document.addEventListener('pointerdown', function (event) {
    if (event.target && event.target.matches(inputSelector)) {
      editingInputs.add(event.target);
      var wrap = event.target.closest('.lp-input-wrap');
      if (wrap) wrap.classList.add('is-editing');
    }
  });
  document.addEventListener('focusin', function (event) {
    if (event.target && event.target.matches(inputSelector)) {
      editingInputs.add(event.target);
      var wrap = event.target.closest('.lp-input-wrap');
      if (wrap) wrap.classList.add('is-editing');
      fixLoginInputFont(event.target);
    }
  });
  document.addEventListener('focusout', function (event) {
    if (event.target && event.target.matches(inputSelector)) {
      window.setTimeout(function () {
        editingInputs.delete(event.target);
        fixLoginInputFont(event.target);
      }, 0);
    }
  });

  document.addEventListener('animationstart', function (event) {
    if (event.animationName !== 'lp-autofill-detect') return;
    var target = event.target;
    if (!target || !target.matches(inputSelector)) return;

    var wrap = target.closest('.lp-input-wrap');
    var mirror = ensureMirror(target);
    fixLoginInputFont(target);

    if (wrap && mirror && !target.value) {
      var prefill = '';
      if (target.type === 'password') {
        prefill = '​'; // 처음엔 빈칸 (아이디와 동일)
      } else {
        try { prefill = localStorage.getItem('lp_saved_id') || ''; } catch(e) {}
        if (!prefill) prefill = '​'; // 투명 유지 (작은 폰트 안 보임)
      }
      if (prefill) {
        mirror.textContent = prefill;
        wrap.classList.add('has-value-mirror');
      }
    }

    var frames = 600;
    (function pump() {
      fixLoginInputFont(target);
      if (!target.value && --frames > 0) requestAnimationFrame(pump);
    }());
  }, true);

  var lpForm = document.querySelector('.lp-login-form');
  if (lpForm) {
    lpForm.addEventListener('submit', function () {
      var u = document.getElementById('loginUsername');
      if (u && u.value) {
        try { localStorage.setItem('lp_saved_id', u.value); } catch(e) {}
      }
    });
  }
}());
</script>

<%- include('partials/footer') %>
