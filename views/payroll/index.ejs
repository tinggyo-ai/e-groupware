<%- include('../partials/head') %>
<main class="container">
  <div class="page-title">
    <h1>급여관리</h1>
    <div class="button-row">
      <a class="button primary" href="/payroll/monthly/new"><i class="fa-solid fa-plus"></i> 월급여 등록</a>
      <a class="button" href="/payroll/salaries/new">연봉정보 등록</a>
    </div>
  </div>

  <p class="muted" style="margin-bottom:14px"><%= thisMonth %> 기준</p>

  <section class="card-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:22px">
    <article class="card kpi-card accent-blue">
      <span>급여 대상자수</span>
      <strong><%= stats.targetCount %>명</strong>
    </article>
    <article class="card kpi-card accent-green">
      <span>총 지급액</span>
      <strong><%= Number(stats.totalPayment).toLocaleString('ko-KR') %>원</strong>
    </article>
    <article class="card kpi-card accent-slate">
      <span>총 공제액</span>
      <strong><%= Number(stats.totalDeduction).toLocaleString('ko-KR') %>원</strong>
    </article>
    <article class="card kpi-card accent-indigo">
      <span>실 지급액</span>
      <strong><%= Number(stats.netPayment).toLocaleString('ko-KR') %>원</strong>
    </article>
    <article class="card kpi-card accent-amber">
      <span>미확정 인원</span>
      <strong><%= stats.unconfirmedCount %>명</strong>
    </article>
    <article class="card kpi-card accent-green">
      <span>지급완료 인원</span>
      <strong><%= stats.paidCount %>명</strong>
    </article>
  </section>

  <div class="two-col">
    <div class="panel">
      <div class="section-head">
        <h2>연봉정보 관리</h2>
        <a class="text-link" href="/payroll/salaries">바로가기</a>
      </div>
      <p style="color:var(--muted);margin:0">직원별 연봉 및 수당 정보를 관리합니다.</p>
    </div>
    <div class="panel">
      <div class="section-head">
        <h2>월별 급여</h2>
        <a class="text-link" href="/payroll/monthly">바로가기</a>
      </div>
      <p style="color:var(--muted);margin:0">월별 급여 지급 내역 및 상세 내역을 조회합니다.</p>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
