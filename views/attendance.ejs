<%- include('partials/head') %>
<main class="container">
  <div class="page-title"><h1>내 근태 이력</h1></div>
  <form class="filter-bar" method="get">
    <label>월 선택 <input type="month" name="month" value="<%= month %>"></label>
    <button class="button" type="submit">조회</button>
  </form>
  <div class="table-wrap">
    <table>
      <thead><tr><th>날짜</th><th>출근</th><th>퇴근</th><th>상태</th><th>메모</th></tr></thead>
      <tbody>
        <% rows.forEach(function(row) { %>
          <tr>
            <td><%= row.work_date %></td>
            <td><%= row.check_in_time ? row.check_in_time.slice(11,16) : '-' %></td>
            <td><%= row.check_out_time ? row.check_out_time.slice(11,16) : '-' %></td>
            <td><span class="badge"><%= row.status %></span></td>
            <td><%= row.memo || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>
<%- include('partials/footer') %>
